    FROM pg_stat_activity
    WHERE state <> 'idle'
      AND query_start IS NOT NULL
    ORDER BY query_start
    LIMIT 20;
    """

    with get_connection() as conn:
        with conn.cursor() as cur:
            cur.execute(query)
            return cur.fetchall()
```

