# ==============================================================================
# AI PostgreSQL DBA Health Assistant - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your actual configuration.
# ==============================================================================

# AWS Region (e.g., us-east-1, us-west-2, eu-west-1)
AWS_REGION=us-east-1

# Optional: Set AWS profile or let boto3 use default credentials / IAM Role
# AWS_PROFILE=default

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection Settings
# ------------------------------------------------------------------------------
RDS_HOST=ip-172-31-31-240.ec2.internal
RDS_PORT=5432
RDS_DATABASE=ragdb
RDS_USER=rag_user
RDS_PASSWORD=rag_pass

# SSL Connection Mode (require is standard for AWS RDS)
RDS_SSLMODE=require

# ------------------------------------------------------------------------------
# AWS Secrets Manager Integration (Recommended for Production)
# If USE_SECRETS_MANAGER is true, credentials will be fetched from Secrets Manager.
# ------------------------------------------------------------------------------
USE_SECRETS_MANAGER=false
RDS_SECRET_NAME=postgres-dba-ai-secret

# ------------------------------------------------------------------------------
# Amazon Bedrock Model Configuration
# ------------------------------------------------------------------------------
# Bedrock Foundation Model for DBA reasoning (e.g. Amazon Nova Lite, Nova Pro, Claude 3 Sonnet)
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Bedrock Embedding Model for pgvector RAG (e.g. Amazon Titan Text Embeddings V2)
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSION=1024

# ------------------------------------------------------------------------------
# RDS CloudWatch Telemetry
# ------------------------------------------------------------------------------
ENABLE_CLOUDWATCH=true
RDS_INSTANCE_IDENTIFIER=ai-postgres-dba

# ------------------------------------------------------------------------------
# Demo / Simulation Mode
# Set to true to test the UI and features with realistic mock data if AWS is offline.
# ------------------------------------------------------------------------------
DEMO_MODE=false
