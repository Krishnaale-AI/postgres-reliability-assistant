# ==============================================================================
# Enterprise .gitignore for AI PostgreSQL DBA Health Assistant
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL - NEVER COMMIT TO GIT)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cer
*.crt
*.pfx
*.p12
credentials.json
aws_credentials
service_account.json
.streamlit/secrets.toml

# ------------------------------------------------------------------------------
# 2. Virtual Environments
# ------------------------------------------------------------------------------
venv/
venv*/
.venv/
.venv*/
env/
env*/
ENV/
virtualenv/
.virtualenv/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/

# ------------------------------------------------------------------------------
# 3. Python Bytecode & Optimization Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# ------------------------------------------------------------------------------
# 4. Logs, Database Dumps & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
*.sqlite
*.sqlite3
*.db
*.bak
*.tmp
*.temp
scratch/
.system_generated/

# ------------------------------------------------------------------------------
# 5. Testing, Linting & Type Checking Artifacts
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/

# ------------------------------------------------------------------------------
# 6. IDEs & Operating System Artifacts
# ------------------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, IntelliJ, etc.)
.idea/

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
